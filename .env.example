# NxtWave learning portal login (SSO / OAuth authorize URL). The page appends
# redirect_uri=<site>/registered.html?registered=1. Leave empty until the
# portal integration is ready: the Register button then shows a
# "Registration opens soon" message instead of a fake confirmation.
VITE_PORTAL_LOGIN_URL=

# TRL8 platform on Replit. After a successful login, students are sent here.
# Leave empty to show the holding screen ("You're registered...").
VITE_PLATFORM_URL=

# Public site URL: canonical link, share previews, sitemap and robots.txt.
# Defaults to https://www.trilight.niatindia.com. Set it only if the domain differs.
VITE_SITE_URL=

# Analytics (optional; set one). GA4 measurement ID, e.g. G-XXXXXXXXXX, or a
# Google Tag Manager container ID, e.g. GTM-XXXXXXX. Funnel events
# (trl8_cta_click, trl8_scroll_depth, trl8_ab_assign, …) flow to whichever is set.
VITE_GA_ID=
VITE_GTM_ID=
