# Replit config for the TRILIGHT site.
# Run (workspace preview): Vite dev server on port 5173.
# Deploy: a Static deployment. Replit runs the build and serves dist/.
modules = ["nodejs-20"]
run = "npm install && npm run dev -- --host 0.0.0.0 --port 5173"

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5173
externalPort = 80

[deployment]
deploymentTarget = "static"
build = ["sh", "-c", "npm ci && npm run build"]
publicDir = "dist"
